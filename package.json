{
  "name": "@mushafjs/root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present && tsc -p scripts",
    "build-data": "tsx scripts/build-page-data.ts && tsx scripts/generate-page-index.ts && tsx scripts/build-quran-index.ts",
    "generate-index": "tsx scripts/generate-page-index.ts",
    "demo": "tsx scripts/serve-demo.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitepress": "^1.6.4"
  }
}
